<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>Buscador de Artistas e Músicas</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="style.css">
 <style>
        body { font-family: sans-serif; padding: 20px; }
        input, button { padding: 10px; }
    </style>
</head>
<body>

<div class="fixed-bar text-center">
  <h2 class="mb-2">Buscador de Artistas e Músicas</h2>
  <div class="input-group mb-2 pe-5 ps-5" data-pg-collapsed><span class="input-group-text"><i class="fa-solid fa-user"></i>&nbsp; Apelido</span>
            <input type="text" class="form-control" id="Username" placeholder="Digite um apelido..." aria-label="Apelido">
            <span class="input-group-text"><i class="fa-solid fa-terminal"></i>&nbsp; Comando</span>
            <input type="text" class="form-control w-25" placeholder="Comando" id="texto" readonly aria-label="Comando">
             <button class="btn btn-primary" type="button" onclick="enviar()"><i class="fa-solid fa-paper-plane"></i> Enviar</button>
             <button class="btn btn-outline-info" type="button" id="btnMeusPedidos" onclick="abrirModalMeusPedidos()"><i class="fa-solid fa-list-check"></i> Meus pedidos</button>
        </div>
    
    <p id="resp"></p>

 <div class="input-group mb-2 pe-5 ps-5">
    <span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-compact-disc"></i></span><input type="text" id="searchArtist"  styl class="form-control" style="width: 40%;" placeholder="Pesquisar artista..." onkeyup="debounceSearch()">
    <span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-music"></i></span><input type="text" id="searchMusic"  style="width: 40%;" class="form-control" placeholder="Pesquisar música..." onkeyup="debounceSearch()">
    <span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-rectangle-list"></i></span><select id="limitSelect" style="width: 6%;" class="form-select" onchange="changeLimit()">
      <option value="10">10</option>
      <option value="20" selected>20</option>
      <option value="30">30</option>
      <option value="40">40</option>
      <option value="50">50</option>
    </select>
  </div>

  <div class="alphabet-nav mb-2">
    <button class="btn btn-outline-secondary btn-sm" onclick="filterByLetter('all')">#</button>
    <script>
      const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
      const container = document.currentScript.parentNode;
      alphabet.forEach(letter => {
        const btn = document.createElement('button');
        btn.className = 'btn btn-outline-secondary btn-sm';
        btn.textContent = letter;
        btn.onclick = () => filterByLetter(letter);
        container.appendChild(btn);
      });
    </script>
  </div>
</div>

<div class="container">
  <div id="bandsContainer" class="accordion"></div>
</div>

<nav id="paginationNav" class="bg-dark py-2">
  <ul id="pagination" class="pagination"></ul>
</nav>

<div id="loader">
  <div class="spinner-border text-primary" role="status">
    <span class="visually-hidden">Carregando...</span>
  </div>
</div>

<div id="toast"></div>

<!-- Modal Meus Pedidos -->
<div class="modal fade" id="modalMeusPedidos" tabindex="-1" aria-labelledby="modalMeusPedidosLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-dark text-white border-secondary shadow-lg">
      <div class="modal-header border-secondary">
        <h5 class="modal-title d-flex align-items-center gap-2" id="modalMeusPedidosLabel">
          <i class="fa-solid fa-list-check text-info"></i> Meus pedidos
          <span id="meusPedidosUsuarioBadge" class="badge bg-secondary fs-6 fw-normal"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body p-0">
        <div id="meusPedidosLoading" class="text-center py-5 d-none">
          <div class="spinner-border text-info mb-2" role="status">
            <span class="visually-hidden">Carregando...</span>
          </div>
          <p class="text-muted mb-0">Consultando seus pedidos...</p>
        </div>
        <div id="meusPedidosVazio" class="text-center py-5 d-none text-muted">
          <i class="fa-solid fa-music fa-2x mb-3 d-block text-secondary"></i>
          <p class="mb-0">Nenhum pedido encontrado para este usuário.</p>
        </div>
        <div class="table-responsive" id="meusPedidosTableContainer">
          <table class="table table-dark table-hover table-striped align-middle mb-0" id="meusPedidosTable">
            <thead>
              <tr class="text-secondary text-uppercase border-secondary" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                <th scope="col" class="text-center py-3" style="width: 70px;">ID</th>
                <th scope="col" class="py-3">Artista</th>
                <th scope="col" class="py-3">Música</th>
                <th scope="col" class="text-center py-3" style="width: 130px;">Status</th>
              </tr>
            </thead>
            <tbody id="meusPedidosBody">
              <!-- Linhas inseridas dinamicamente -->
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer border-secondary d-flex justify-content-between">
        <button type="button" class="btn btn-outline-info btn-sm" id="btnAtualizarMeusPedidos" onclick="carregarMeusPedidos(true)">
          <i class="fa-solid fa-rotate" id="iconAtualizarMeusPedidos"></i> Atualizar
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="script.js"></script>
</body>
</html>
