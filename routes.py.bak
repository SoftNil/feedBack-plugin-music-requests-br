"""Music Requests (Pedidos de Música) plugin — API and incremental catalog synchronization."""

import json
import logging
import os
import threading
import uuid
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

from fastapi import FastAPI, HTTPException, Query, Request, Response
from fastapi.responses import JSONResponse

# ---- Constants ----
PLUGIN_ID = "music_requests"
PLUGIN_LABEL = "Pedidos de Música"
API = "/api/plugins/" + PLUGIN_ID

# Dynamic path resolution relative to this plugin's location
PLUGIN_DIR = Path(__file__).resolve().parent
LISTA_DIR = PLUGIN_DIR / "lista"
BANDS_FILE = LISTA_DIR / "bands.json"
REQUESTS_FILE = LISTA_DIR / "requests.json"

# Concurrency lock for requests.json read/modify/write operations
_requests_lock = threading.RLock()

# CORS response headers
CORS_HEADERS = {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With, ngrok-skip-browser-warning, Accept, Origin",
    "Access-Control-Max-Age": "86400",
}


def _cors_response(content: Any, status_code: int = 200) -> JSONResponse:
    """Return JSONResponse with permissive CORS headers for external web clients (e.g. GitHub Pages)."""
    return JSONResponse(content=content, status_code=status_code, headers=CORS_HEADERS)


# Module state populated during setup()
_state: Dict[str, Any] = {
    "meta_db": None,
    "log": logging.getLogger("feedBack.plugins.music_requests"),
}


# ── Path and File Helpers ───────────────────────────────────────────────────

def _get_bands_file_path() -> Path:
    """Return the resolved Path for lista/bands.json, ensuring the parent directory exists."""
    LISTA_DIR.mkdir(parents=True, exist_ok=True)
    return BANDS_FILE


def _get_requests_file_path() -> Path:
    """Return the resolved Path for lista/requests.json, ensuring it exists with initial format."""
    LISTA_DIR.mkdir(parents=True, exist_ok=True)
    with _requests_lock:
        if not REQUESTS_FILE.is_file():
            init_data = {"requests": []}
            temp_file = REQUESTS_FILE.with_name(f"{REQUESTS_FILE.name}.tmp.{uuid.uuid4().hex}")
            try:
                temp_file.write_text(json.dumps(init_data, indent=4, ensure_ascii=False), encoding="utf-8")
                os.replace(temp_file, REQUESTS_FILE)
            except Exception:
                if temp_file.exists():
                    try:
                        temp_file.unlink()
                    except OSError:
                        pass
                raise
    return REQUESTS_FILE


def _get_display_path(file_path: Path) -> str:
    """Return a clean relative display path for the UI (e.g. 'lista/bands.json')."""
    try:
        return str(file_path.relative_to(PLUGIN_DIR))
    except Exception:
        return file_path.name


# ── Catalog Synchronization Logic ──────────────────────────────────────────

def _read_existing_catalog(catalog_path: Path) -> Tuple[Set[str], Set[Tuple[str, str]]]:
    """Read existing bands.json and extract artist set and (artist, song_title) pairs."""
    existing_artists: Set[str] = set()
    existing_catalog_pairs: Set[Tuple[str, str]] = set()

    if not catalog_path.is_file():
        return existing_artists, existing_catalog_pairs

    try:
        data = json.loads(catalog_path.read_text(encoding="utf-8"))
        bands = data.get("bands", [])
        if isinstance(bands, list):
            for band in bands:
                if not isinstance(band, dict):
                    continue
                artist = str(band.get("artist", "")).strip()
                if not artist:
                    continue
                existing_artists.add(artist)

                songs = band.get("songs", [])
                if isinstance(songs, list):
                    for song in songs:
                        if isinstance(song, dict):
                            title = str(song.get("title", "")).strip()
                        elif isinstance(song, str):
                            title = song.strip()
                        else:
                            continue
                        if title:
                            existing_catalog_pairs.add((artist, title))
    except Exception as exc:
        _state["log"].warning(f"{PLUGIN_LABEL}: Failed to parse existing catalog {catalog_path}: {exc}")

    return existing_artists, existing_catalog_pairs


def _extract_meta_db_catalog(meta_db: Any) -> Tuple[Set[str], Dict[str, Set[str]], Set[Tuple[str, str]]]:
    """Extract artists and songs from FeedBack's meta_db.
    
    Returns:
        (current_artists, current_artist_songs, current_catalog_pairs)
    """
    current_artists: Set[str] = set()
    current_artist_songs: Dict[str, Set[str]] = defaultdict(set)
    current_catalog_pairs: Set[Tuple[str, str]] = set()

    if meta_db is None or not hasattr(meta_db, "conn") or meta_db.conn is None:
        return current_artists, current_artist_songs, current_catalog_pairs

    lock = getattr(meta_db, "_lock", None)
    try:
        query = (
            "SELECT artist, title FROM songs "
            "WHERE artist IS NOT NULL AND TRIM(artist) != '' "
            "AND title IS NOT NULL AND TRIM(title) != ''"
        )
        if lock:
            with lock:
                rows = meta_db.conn.execute(query).fetchall()
        else:
            rows = meta_db.conn.execute(query).fetchall()

        for row in rows:
            artist = str(row[0]).strip()
            title = str(row[1]).strip()
            if artist and title:
                current_artists.add(artist)
                current_artist_songs[artist].add(title)
                current_catalog_pairs.add((artist, title))

    except Exception as exc:
        _state["log"].error(f"{PLUGIN_LABEL}: Error querying songs from meta_db: {exc}")

    return current_artists, current_artist_songs, current_catalog_pairs


def sync_catalog(meta_db: Any, catalog_path: Optional[Path] = None) -> Dict[str, Any]:
    """Perform incremental synchronization between meta_db and lista/bands.json."""
    if catalog_path is None:
        catalog_path = _get_bands_file_path()

    existing_artists, existing_catalog_pairs = _read_existing_catalog(catalog_path)
    current_artists, current_artist_songs, current_catalog_pairs = _extract_meta_db_catalog(meta_db)

    # Consistent set-based diff calculation
    added_artists = current_artists - existing_artists
    removed_artists = existing_artists - current_artists
    added_songs = current_catalog_pairs - existing_catalog_pairs
    removed_songs = existing_catalog_pairs - current_catalog_pairs

    total_artists = len(current_artists)
    total_songs = len(current_catalog_pairs)

    file_exists = catalog_path.is_file()
    has_changes = bool(
        added_artists
        or removed_artists
        or added_songs
        or removed_songs
        or not file_exists
    )

    if has_changes:
        # Strictly structured JSON format matching requirements
        bands = []
        for artist in sorted(current_artists, key=lambda a: (a.lower(), a)):
            song_titles = sorted(list(current_artist_songs[artist]), key=lambda t: (t.lower(), t))
            bands.append({
                "artist": artist,
                "songs": [
                    {
                        "title": title
                    }
                    for title in song_titles
                ]
            })

        catalog_data = {
            "bands": bands
        }

        # Atomic file write to ensure previous bands.json is preserved on error
        catalog_path.parent.mkdir(parents=True, exist_ok=True)
        temp_file = catalog_path.with_name(f"{catalog_path.name}.tmp.{uuid.uuid4().hex}")
        try:
            temp_file.write_text(json.dumps(catalog_data, indent=4, ensure_ascii=False), encoding="utf-8")
            os.replace(temp_file, catalog_path)
            _state["log"].info(
                f"{PLUGIN_LABEL}: Catalog updated successfully in {catalog_path}: "
                f"+{len(added_songs)} / -{len(removed_songs)} songs, "
                f"+{len(added_artists)} / -{len(removed_artists)} artists. Total: {total_songs} songs, {total_artists} artists."
            )
        except Exception as exc:
            if temp_file.exists():
                try:
                    temp_file.unlink()
                except OSError:
                    pass
            _state["log"].error(f"{PLUGIN_LABEL}: Failed to write catalog file atomically: {exc}")
            raise
    else:
        _state["log"].info(
            f"{PLUGIN_LABEL}: No changes in library. Skipping catalog file rewrite. Total: {total_songs} songs, {total_artists} artists."
        )

    return {
        "ok": True,
        "has_changes": has_changes,
        "arquivo": _get_display_path(catalog_path),
        "caminho_absoluto": str(catalog_path),
        "musicas_adicionadas": len(added_songs),
        "musicas_removidas": len(removed_songs),
        "artistas_adicionados": len(added_artists),
        "artistas_removidos": len(removed_artists),
        "total_artistas": total_artists,
        "total_musicas": total_songs,
        "detalhes": {
            "musicas_adicionadas": [{"artist": a, "title": t} for a, t in sorted(added_songs)],
            "musicas_removidas": [{"artist": a, "title": t} for a, t in sorted(removed_songs)],
            "artistas_adicionados": sorted(list(added_artists)),
            "artistas_removidos": sorted(list(removed_artists)),
        }
    }


# ── Requests Management Logic ───────────────────────────────────────────────

def _find_song_in_catalog(artist: str, title: str, catalog_path: Optional[Path] = None) -> Optional[Tuple[str, str]]:
    """Validate if a song exists in lista/bands.json and return its canonical (artist, title)."""
    if catalog_path is None:
        catalog_path = _get_bands_file_path()

    if not catalog_path.is_file():
        return None

    try:
        data = json.loads(catalog_path.read_text(encoding="utf-8"))
        bands = data.get("bands", [])
        if not isinstance(bands, list):
            return None

        artist_norm = artist.strip().lower()
        title_norm = title.strip().lower()

        for band in bands:
            if not isinstance(band, dict):
                continue
            b_artist = str(band.get("artist", "")).strip()
            if b_artist.lower() == artist_norm:
                for song in band.get("songs", []):
                    if isinstance(song, dict):
                        s_title = str(song.get("title", "")).strip()
                    elif isinstance(song, str):
                        s_title = song.strip()
                    else:
                        continue
                    if s_title.lower() == title_norm:
                        return (b_artist, s_title)
    except Exception as exc:
        _state["log"].error(f"{PLUGIN_LABEL}: Error reading catalog {catalog_path}: {exc}")

    return None


def _find_filename_in_meta_db(artist: str, title: str) -> Optional[str]:
    """Look up the official song filename in FeedBack's meta_db for given artist and title."""
    meta_db = _state.get("meta_db")
    if meta_db is None or not hasattr(meta_db, "conn") or meta_db.conn is None:
        return None

    lock = getattr(meta_db, "_lock", None)
    artist_clean = artist.strip()
    title_clean = title.strip()

    # 1. Exact case-insensitive match
    query_exact = (
        "SELECT filename FROM songs "
        "WHERE LOWER(TRIM(artist)) = LOWER(TRIM(?)) "
        "AND LOWER(TRIM(title)) = LOWER(TRIM(?)) "
        "LIMIT 1"
    )
    try:
        if lock:
            with lock:
                row = meta_db.conn.execute(query_exact, (artist_clean, title_clean)).fetchone()
        else:
            row = meta_db.conn.execute(query_exact, (artist_clean, title_clean)).fetchone()
        if row and row[0]:
            return str(row[0])
    except Exception as exc:
        _state["log"].error(f"{PLUGIN_LABEL}: Error querying meta_db for filename: {exc}")

    # 2. Match via canonical catalog pair if available
    matched = _find_song_in_catalog(artist_clean, title_clean)
    if matched:
        c_artist, c_title = matched
        try:
            if lock:
                with lock:
                    row = meta_db.conn.execute(query_exact, (c_artist, c_title)).fetchone()
            else:
                row = meta_db.conn.execute(query_exact, (c_artist, c_title)).fetchone()
            if row and row[0]:
                return str(row[0])
        except Exception:
            pass

    return None


def _read_requests_data(requests_path: Optional[Path] = None) -> Dict[str, Any]:
    """Read requests.json safely under lock. Creates the file if not present."""
    if requests_path is None:
        requests_path = _get_requests_file_path()

    with _requests_lock:
        if not requests_path.is_file():
            return {"requests": []}
        try:
            data = json.loads(requests_path.read_text(encoding="utf-8"))
            if not isinstance(data, dict) or "requests" not in data or not isinstance(data["requests"], list):
                return {"requests": []}
            return data
        except Exception as exc:
            _state["log"].error(f"{PLUGIN_LABEL}: Error reading requests from {requests_path}: {exc}")
            return {"requests": []}


def _save_requests_data(data: Dict[str, Any], requests_path: Optional[Path] = None) -> None:
    """Save requests.json atomically under lock."""
    if requests_path is None:
        requests_path = _get_requests_file_path()

    with _requests_lock:
        requests_path.parent.mkdir(parents=True, exist_ok=True)
        temp_file = requests_path.with_name(f"{requests_path.name}.tmp.{uuid.uuid4().hex}")
        try:
            temp_file.write_text(json.dumps(data, indent=4, ensure_ascii=False), encoding="utf-8")
            os.replace(temp_file, requests_path)
        except Exception as exc:
            if temp_file.exists():
                try:
                    temp_file.unlink()
                except OSError:
                    pass
            _state["log"].error(f"{PLUGIN_LABEL}: Failed to write requests file atomically: {exc}")
            raise


# ── Plugin FastAPI Setup ────────────────────────────────────────────────────

def setup(app: FastAPI, context: dict) -> None:
    """Plugin entry point called by FeedBack host during startup."""
    log = context.get("log") or logging.getLogger("feedBack.plugins.music_requests")
    _state["log"] = log
    _state["meta_db"] = context.get("meta_db")

    # Ensure lista folder and files exist
    _get_bands_file_path()
    _get_requests_file_path()

    # ── CORS Preflight Options Handler ──────────────────────────────────────

    @app.options(f"{API}/{{rest_of_path:path}}")
    async def cors_preflight_handler(rest_of_path: str) -> Response:
        """Handle CORS preflight requests from browsers and external origins."""
        return Response(status_code=200, headers=CORS_HEADERS)

    # ── Override static/v3/shell.js to promote music_requests into Sidebar ─
    @app.get("/static/v3/shell.js")
    async def get_promoted_shell_js() -> Response:
        """Serve shell.js with music_requests promoted to the sidebar next to Playlists."""
        shell_path = Path("/opt/fee[dB]ack/resources/slopsmith/static/v3/shell.js")
        if not shell_path.is_file():
            return Response(status_code=404, content="shell.js not found")

        content = shell_path.read_text(encoding="utf-8")
        target_nav = "{ key: 'audio_engine', screen: 'plugin-audio_engine', label: 'Audio', group: null,        icon: 'amp' },"
        replacement_nav = (
            target_nav + "\n        { key: 'music_requests', screen: 'plugin-music_requests', label: 'Pedidos', group: null, icon: 'list' },"
        )
        target_promo = "{ navKey: 'audio_engine', pluginId: 'audio_engine', slotId: 'v3-nav-audio-engine', anchorAfter: 'settings' },"
        replacement_promo = (
            target_promo + "\n        { navKey: 'music_requests', pluginId: 'music_requests', slotId: 'v3-nav-music-requests', anchorAfter: 'playlists' },"
        )
        if target_nav in content and target_promo in content:
            content = content.replace(target_nav, replacement_nav).replace(target_promo, replacement_promo)

        return Response(
            content=content,
            media_type="application/javascript",
            headers={"Cache-Control": "no-cache, must-revalidate"}
        )

    # ── Catalog Endpoints ───────────────────────────────────────────────────

    @app.post(f"{API}/sync")
    async def sync_endpoint(request: Request) -> JSONResponse:
        """Trigger incremental synchronization between meta_db and lista/bands.json."""
        try:
            meta_db = _state["meta_db"]
            if meta_db is None or not hasattr(meta_db, "conn") or meta_db.conn is None:
                return _cors_response(
                    status_code=503,
                    content={
                        "ok": False,
                        "error": "Biblioteca de metadados (meta_db) indisponível no momento."
                    }
                )
            result = sync_catalog(meta_db)
            return _cors_response(content=result, status_code=200)
        except Exception as exc:
            log.exception(f"{PLUGIN_LABEL}: Erro na sincronização do catálogo: {exc}")
            return _cors_response(
                status_code=500,
                content={
                    "ok": False,
                    "error": f"Erro interno na sincronização: {str(exc)}"
                }
            )

    @app.get(f"{API}/catalog")
    @app.get(f"{API}/bands.json")
    async def get_catalog_endpoint() -> JSONResponse:
        """Return the current lista/bands.json catalog."""
        cat_file = _get_bands_file_path()
        if not cat_file.is_file():
            return _cors_response(content={"bands": []}, status_code=200)
        try:
            data = json.loads(cat_file.read_text(encoding="utf-8"))
            return _cors_response(content=data, status_code=200)
        except Exception as exc:
            return _cors_response(
                status_code=500,
                content={"ok": False, "error": f"Erro ao ler catálogo: {str(exc)}"}
            )

    @app.get(f"{API}/status")
    async def get_status_endpoint() -> JSONResponse:
        """Return status information about lista/bands.json and requests."""
        cat_file = _get_bands_file_path()
        req_file = _get_requests_file_path()
        existing_artists, existing_catalog_pairs = _read_existing_catalog(cat_file)
        requests_data = _read_requests_data(req_file)
        req_list = requests_data.get("requests", [])

        return _cors_response(
            content={
                "ok": True,
                "arquivo_catalogo": _get_display_path(cat_file),
                "arquivo_pedidos": _get_display_path(req_file),
                "total_artistas": len(existing_artists),
                "total_musicas": len(existing_catalog_pairs),
                "total_pedidos": len(req_list),
            },
            status_code=200
        )

    # ── Request API Endpoints ───────────────────────────────────────────────

    @app.post(f"{API}/request")
    async def create_request_endpoint(request: Request) -> JSONResponse:
        """Create a new song request after validating against lista/bands.json."""
        try:
            body = await request.json()
        except Exception:
            return _cors_response(
                status_code=400,
                content={"ok": False, "error": "Corpo da requisição deve ser um JSON válido."}
            )

        if not isinstance(body, dict):
            return _cors_response(
                status_code=400,
                content={"ok": False, "error": "Formato JSON inválido."}
            )

        usuario = str(body.get("usuario", "")).strip()
        artist = str(body.get("artist", "")).strip()
        title = str(body.get("title", "")).strip()

        # 1. Validation of required fields
        if not usuario:
            return _cors_response(
                status_code=400,
                content={"ok": False, "error": "O campo 'usuario' é obrigatório."}
            )
        if not artist:
            return _cors_response(
                status_code=400,
                content={"ok": False, "error": "O campo 'artist' é obrigatório."}
            )
        if not title:
            return _cors_response(
                status_code=400,
                content={"ok": False, "error": "O campo 'title' é obrigatório."}
            )

        # 2. Check if the song exists in lista/bands.json
        matched_song = _find_song_in_catalog(artist, title)
        if not matched_song:
            return _cors_response(
                status_code=400,
                content={
                    "ok": False,
                    "error": f"A música '{title}' do artista '{artist}' não foi encontrada no catálogo de músicas."
                }
            )

        canonical_artist, canonical_title = matched_song

        with _requests_lock:
            data = _read_requests_data()
            requests_list = data.get("requests", [])

            # 3. Duplicate check: prevent duplicate identical requests while status is 'pending'
            for req in requests_list:
                if not isinstance(req, dict):
                    continue
                if (
                    str(req.get("status", "")).lower() == "pending"
                    and str(req.get("usuario", "")).strip().lower() == usuario.lower()
                    and str(req.get("artist", "")).strip().lower() == canonical_artist.lower()
                    and str(req.get("title", "")).strip().lower() == canonical_title.lower()
                ):
                    return _cors_response(
                        status_code=409,
                        content={
                            "ok": False,
                            "error": f"Já existe um pedido pendente idêntico para o usuário '{usuario}' ({canonical_artist} - {canonical_title})."
                        }
                    )

            # 4. Generate unique integer ID
            existing_ids = [
                int(r["id"]) for r in requests_list
                if isinstance(r, dict) and "id" in r and str(r["id"]).isdigit()
            ]
            new_id = (max(existing_ids) + 1) if existing_ids else 1

            # 5. Build request object
            new_request = {
                "id": new_id,
                "usuario": usuario,
                "artist": canonical_artist,
                "title": canonical_title,
                "status": "pending",
                "created_at": datetime.now().isoformat(timespec="seconds")
            }

            requests_list.append(new_request)
            data["requests"] = requests_list

            try:
                _save_requests_data(data)
            except Exception as exc:
                log.exception(f"{PLUGIN_LABEL}: Erro ao salvar pedido: {exc}")
                return _cors_response(
                    status_code=500,
                    content={"ok": False, "error": "Erro interno ao salvar pedido."}
                )

        log.info(f"{PLUGIN_LABEL}: Pedido #{new_id} criado para '{usuario}': {canonical_artist} - {canonical_title}")
        return _cors_response(
            status_code=201,
            content={
                "ok": True,
                "message": "Pedido criado com sucesso.",
                "request": new_request
            }
        )

    @app.get(f"{API}/requests")
    async def list_requests_endpoint(status: Optional[str] = Query(None)) -> JSONResponse:
        """List requests from lista/requests.json with optional status filter."""
        with _requests_lock:
            data = _read_requests_data()
            requests_list = data.get("requests", [])

        if status:
            status_norm = status.strip().lower()
            filtered = [r for r in requests_list if isinstance(r, dict) and str(r.get("status", "")).lower() == status_norm]
            return _cors_response(
                status_code=200,
                content={
                    "ok": True,
                    "total": len(filtered),
                    "requests": filtered
                }
            )

        return _cors_response(
            status_code=200,
            content={
                "ok": True,
                "total": len(requests_list),
                "requests": requests_list
            }
        )

    @app.delete(f"{API}/request/{{id}}")
    async def delete_request_endpoint(id: int) -> JSONResponse:
        """Delete a song request by ID from lista/requests.json."""
        with _requests_lock:
            data = _read_requests_data()
            requests_list = data.get("requests", [])

            index_to_remove = None
            for idx, req in enumerate(requests_list):
                if isinstance(req, dict) and req.get("id") == id:
                    index_to_remove = idx
                    break

            if index_to_remove is None:
                return _cors_response(
                    status_code=404,
                    content={"ok": False, "error": f"Pedido com ID {id} não encontrado."}
                )

            deleted_request = requests_list.pop(index_to_remove)
            data["requests"] = requests_list

            try:
                _save_requests_data(data)
            except Exception as exc:
                log.exception(f"{PLUGIN_LABEL}: Erro ao salvar lista após exclusão: {exc}")
                return _cors_response(
                    status_code=500,
                    content={"ok": False, "error": "Erro interno ao atualizar pedidos."}
                )

    @app.post(f"{API}/request/{{id}}/play")
    async def play_request_endpoint(id: int) -> JSONResponse:
        """Set a request's status to 'playing' if found in meta_db and revert any other 'playing' request to 'pending'."""
        with _requests_lock:
            data = _read_requests_data()
            requests_list = data.get("requests", [])

            target_req = None
            for req in requests_list:
                if isinstance(req, dict) and req.get("id") == id:
                    target_req = req
                    break

            if target_req is None:
                return _cors_response(
                    status_code=404,
                    content={"ok": False, "error": f"Pedido com ID {id} não encontrado."}
                )

            artist = str(target_req.get("artist", "")).strip()
            title = str(target_req.get("title", "")).strip()

            # Consult meta_db for the corresponding filename
            filename = _find_filename_in_meta_db(artist, title)
            if not filename:
                log.warning(f"{PLUGIN_LABEL}: Música '{title}' do artista '{artist}' não encontrada no meta_db.")
                return _cors_response(
                    status_code=404,
                    content={"ok": False, "error": "Música não encontrada na biblioteca"}
                )

            # Revert any currently playing song to pending
            for req in requests_list:
                if isinstance(req, dict) and req.get("id") != id:
                    if str(req.get("status", "")).lower() == "playing":
                        req["status"] = "pending"

            # Set the selected song to playing
            target_req["status"] = "playing"
            data["requests"] = requests_list

            try:
                _save_requests_data(data)
            except Exception as exc:
                log.exception(f"{PLUGIN_LABEL}: Erro ao salvar lista após alterar status para playing: {exc}")
                return _cors_response(
                    status_code=500,
                    content={"ok": False, "error": "Erro interno ao atualizar status do pedido."}
                )

        log.info(f"{PLUGIN_LABEL}: Pedido #{id} ({artist} - {title}) iniciado no player (filename: {filename}).")
        return _cors_response(
            status_code=200,
            content={
                "ok": True,
                "message": f"Pedido {id} agora está tocando.",
                "filename": filename,
                "request": target_req
            }
        )

    @app.post(f"{API}/request/finish-playing")
    @app.post(f"{API}/request/{{id}}/played")
    async def finish_playing_endpoint(id: Optional[int] = None) -> JSONResponse:
        """Mark currently playing (or specified) request as 'played' when playback finishes naturally."""
        with _requests_lock:
            data = _read_requests_data()
            requests_list = data.get("requests", [])

            finished_req = None
            for req in requests_list:
                if not isinstance(req, dict):
                    continue
                if id is not None and req.get("id") == id:
                    if str(req.get("status", "")).lower() == "playing":
                        req["status"] = "played"
                        finished_req = req
                    else:
                        finished_req = req  # Already in another state, no change needed
                    break
                elif id is None and str(req.get("status", "")).lower() == "playing":
                    req["status"] = "played"
                    finished_req = req
                    break

            if finished_req is None:
                return _cors_response(
                    status_code=200,
                    content={"ok": True, "message": "Nenhum pedido tocando para finalizar.", "request": None}
                )

            # Only save if we actually updated status to played
            if str(finished_req.get("status", "")).lower() == "played":
                data["requests"] = requests_list
                try:
                    _save_requests_data(data)
                except Exception as exc:
                    log.exception(f"{PLUGIN_LABEL}: Erro ao salvar lista após finalizar música: {exc}")
                    return _cors_response(
                        status_code=500,
                        content={"ok": False, "error": "Erro interno ao finalizar status do pedido."}
                    )

        log.info(f"{PLUGIN_LABEL}: Pedido #{finished_req.get('id')} marcado como played.")
        return _cors_response(
            status_code=200,
            content={
                "ok": True,
                "message": f"Pedido {finished_req.get('id')} finalizado com sucesso.",
                "request": finished_req
            }
        )

    @app.post(f"{API}/request/stop-playing")
    @app.post(f"{API}/request/{{id}}/stop")
    async def stop_playing_endpoint(id: Optional[int] = None) -> JSONResponse:
        """Revert currently playing (or specified) request back to 'pending' when playback is interrupted (ESC)."""
        with _requests_lock:
            data = _read_requests_data()
            requests_list = data.get("requests", [])

            stopped_req = None
            for req in requests_list:
                if not isinstance(req, dict):
                    continue
                if id is not None and req.get("id") == id:
                    if str(req.get("status", "")).lower() == "playing":
                        req["status"] = "pending"
                        stopped_req = req
                    else:
                        stopped_req = req  # Already in another state (e.g. played or pending), no change
                    break
                elif id is None and str(req.get("status", "")).lower() == "playing":
                    req["status"] = "pending"
                    stopped_req = req
                    break

            if stopped_req is None:
                return _cors_response(
                    status_code=200,
                    content={"ok": True, "message": "Nenhum pedido tocando para interromper.", "request": None}
                )

            # Only save if status is pending
            if str(stopped_req.get("status", "")).lower() == "pending":
                data["requests"] = requests_list
                try:
                    _save_requests_data(data)
                except Exception as exc:
                    log.exception(f"{PLUGIN_LABEL}: Erro ao salvar lista após interromper música: {exc}")
                    return _cors_response(
                        status_code=500,
                        content={"ok": False, "error": "Erro interno ao interromper status do pedido."}
                    )

        log.info(f"{PLUGIN_LABEL}: Pedido #{stopped_req.get('id')} interrompido e retornado para pending.")
        return _cors_response(
            status_code=200,
            content={
                "ok": True,
                "message": f"Pedido {stopped_req.get('id')} interrompido e retornado para pendente.",
                "request": stopped_req
            }
        )

    log.info(f"{PLUGIN_LABEL}: routes registered (catalog at {BANDS_FILE}, requests at {REQUESTS_FILE})")
